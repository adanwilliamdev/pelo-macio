# Copie para .env e ajuste. Usado pelo docker-compose (todos os valores têm padrão para demonstração local).
DB_USER=pelomacio
DB_PASSWORD=troque-esta-senha
PELOMACIO_JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
PELOMACIO_CORS_ORIGINS=http://localhost:8081
# true: cria duas lojas de exemplo no primeiro start. Em produção use false.
PELOMACIO_DEMO=true
PELOMACIO_DEMO_SENHA=demo1234
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Google Calendar (opcional). Veja "Integração com o Google Calendar" no README.
# O redirect URI abaixo precisa estar cadastrado no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/google/callback
PELOMACIO_FRONTEND_URL=http://localhost:8081
PELOMACIO_TIMEZONE=America/Sao_Paulo
# Chave que cifra os tokens do Google no banco. Vazia = derivada de PELOMACIO_JWT_SECRET.
PELOMACIO_TOKEN_KEY=
